# Copy this file to ".env" and fill in your values.
# You can also set the API key from the app: Settings -> Gemini API key.

# Required - get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - folder names created next to the source SRT file
# (leave empty for the defaults: split / merge / translated_file)
CUSTOM_SPLIT_DIR=
CUSTOM_MERGE_DIR=
CUSTOM_OUTPUT_DIR=

# Optional - subtitle blocks per Gemini call (default 150)
CHUNK_SIZE=150

# Optional - translation model: gemini-3.8-flash | gemini-3.5-flash-lite | gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Optional - Flex inference (preview): 50% cheaper but slower; 1 = on, 0 = off (default 0)
# Falls back to the standard tier (full price) if Flex is busy.
FLEX_MODE=0

# Optional - how much Gemini "thinks" before answering: low | medium | high (default low)
# Thinking tokens are billed as output, so low is the cheapest.
THINKING_LEVEL=low

# Optional - UI preferences (saved automatically by the app)
# UI_LANG: he | en      UI_THEME: system | dark | light
UI_LANG=he
UI_THEME=system
